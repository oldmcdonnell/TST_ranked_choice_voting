# Copy to .env and fill in for real deployment
PORT=8787
DB_PATH=./data/tstky.sqlite

# Set to a long random string in production
SESSION_SECRET=change-me-dev-only

# How long a login stays valid before you have to click a fresh magic
# link (idle expiry, in hours). Members only need to be logged in long
# enough to cast a ballot, so this defaults short rather than 30 days.
SESSION_HOURS=4

# Where the frontend is hosted, for CORS + links in emails
FRONTEND_URL=http://localhost:5173

# Email sending via Resend (https://resend.com) — see src/lib/mailer.js.
# Leave RESEND_API_KEY empty in local dev: emails are printed to the
# backend console instead, so you can copy login/invite links from there.
# For real sending, set the key and use a MAIL_FROM address on a domain
# you've verified in Resend.
RESEND_API_KEY=
MAIL_FROM=no-reply@tstky.example

# TEMPORARY shared admin passcode, sent as the x-admin-key header on
# every admin request (see src/routes/admin-auth.js). Admin pages refuse
# all requests if this is empty. Use a long random value; the dev admin
# login hands this key to the browser. To be replaced by WebAuthn/YubiKey
# below — do NOT rely on this in production.
ADMIN_STUB_KEY=change-me-dev-only

# WebAuthn / FIDO2 admin login (fill in once you have a real domain)
RP_NAME=TST Kentucky Admin
RP_ID=localhost
ORIGIN=http://localhost:5173

# Local-only shortcut login for exercising the app without the real
# invite-email / admin-key dance. NEVER set this to true in a real
# deployment — see routes/dev-login.js. Leave unset/false to keep
# /api/dev/login from existing at all.
DEV_LOGIN_ENABLED=false
DEV_ADMIN_EMAIL=admin@test.local
DEV_ADMIN_PASSWORD=admin123
DEV_USER_EMAIL=user@test.local
DEV_USER_PASSWORD=user123
